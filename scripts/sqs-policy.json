{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Service": "s3.amazonaws.com"
            },
            "Action": "SQS:SendMessage",
            "Resource": "arn:aws:sqs:us-east-1:000000000000:evento-novo-video",
            "Condition": {
                "ArnLike": {
                    "aws:SourceArn": "arn:aws:s3:::bucket-videos"
                }
            }
        }
    ]
}